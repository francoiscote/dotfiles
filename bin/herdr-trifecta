#!/usr/bin/env bash
# herdr-trifecta — open a 3-tab layout for a project in the current Herdr workspace.
#
#   tab 1 "CLI": the caller's tab, relabeled, with a split (two panes side-by-side)
#   tab 2 "AI" : new tab with a `pi` coding agent started in its pane
#   tab 3 "git": a plain shell for git work
#
# The caller's tab becomes the CLI tab (split into two shells); the AI and git
# tabs are created to the right without stealing focus. Run this from the pane
# you want to use as the left-half of the CLI split.
#
# Requires: HERDR_ENV=1, herdr in PATH, jq in PATH.

set -euo pipefail

die() { echo "herdr-trifecta: $*" >&2; exit 1; }

command -v herdr >/dev/null || die "herdr not found in PATH"
command -v jq    >/dev/null || die "jq not found in PATH"
[ "${HERDR_ENV:-}" = 1 ]    || die "not running inside Herdr (HERDR_ENV != 1). Run this from a Herdr-managed pane."

WORKSPACE="${HERDR_WORKSPACE_ID:?missing HERDR_WORKSPACE_ID}"
ORIG_TAB="${HERDR_TAB_ID:?missing HERDR_TAB_ID}"
ORIG_PANE="${HERDR_PANE_ID:?missing HERDR_PANE_ID}"
CWD="$PWD"

# Extract a field from the last herdr JSON response.
#   jget .result.tab.tab_id
jget() { jq -r "$1 // empty" <<<"$RESP"; }

echo "› workspace: $WORKSPACE   cwd: $CWD"

# --- tab 1: CLI (relabel caller's tab + split) ------------------------------
# The caller's tab becomes CLI — relabel and split it side-by-side.
herdr tab rename "$ORIG_TAB" "CLI" >/dev/null \
  || die "failed to relabel CLI tab ($ORIG_TAB)"

RESP=$(herdr pane split --pane "$ORIG_PANE" --direction down --cwd "$CWD")
CLI_PANE2=$(jget .result.pane.pane_id)
[ -n "$CLI_PANE2" ] || die "failed to split CLI pane: $RESP"
echo "› CLI tab: $ORIG_TAB  panes: $ORIG_PANE | $CLI_PANE2"

# --- tab 2: AI --------------------------------------------------------------
# Fresh tab — pi starts here. Since the pane is new and already at a shell
# prompt, the polling loop below should complete almost instantly.
RESP=$(herdr tab create --workspace "$WORKSPACE" --cwd "$CWD" --label "AI" --no-focus)
AI_TAB=$(jget .result.tab.tab_id)
AI_PANE=$(jget .result.root_pane.pane_id)
[ -n "$AI_TAB" ] && [ -n "$AI_PANE" ] || die "failed to create AI tab: $RESP"
echo "› AI tab: $AI_TAB  pane: $AI_PANE"

# `agent start` requires the pane to already be at an interactive shell prompt,
# but this pane is busy running this very script, so it is NOT at a prompt yet.
# It only returns to its prompt after this script exits. We therefore detach a
# helper that polls `pane process-info` until the shell is back in the
# foreground (foreground pid == shell_pid), then starts pi. The helper is
# disowned so it survives this script's exit; `agent start` itself then waits
# for pi to be detected and ready for input. A poll timeout guards against
# spinning forever if the shell never returns.
( deadline=$(( $(date +%s) + 60 ))
  until [ "$(herdr pane process-info --pane "$AI_PANE" 2>/dev/null \
              | jq -r '.result.process_info
                       | ((.foreground_processes[0].pid // 0) == .shell_pid)')" = "true" ]; do
    [ "$(date +%s)" -ge "$deadline" ] && exit 1
    sleep 0.3
  done
  herdr agent start pi-agent --kind pi --pane "$AI_PANE" ) </dev/null >/dev/null 2>&1 &
disown 2>/dev/null || true
echo "› AI tab will start pi momentarily"

# --- tab 3: git -------------------------------------------------------------
RESP=$(herdr tab create --workspace "$WORKSPACE" --cwd "$CWD" --label "git" --no-focus)
GIT_TAB=$(jget .result.tab.tab_id)
GIT_PANE=$(jget .result.root_pane.pane_id)
[ -n "$GIT_TAB" ] && [ -n "$GIT_PANE" ] || die "failed to create git tab: $RESP"
herdr pane run "$GIT_PANE" lazygit
echo "› git tab: $GIT_TAB  (lazygit starting at $CWD)"

# Focus stays on CLI (the caller's tab) since no focus-stealing occurred.
echo "✓ trifecta ready — CLI ($ORIG_TAB) · AI ($AI_TAB) · git ($GIT_TAB)"
echo "  pi is starting in the AI tab."
