#!/usr/bin/env bash
# herdr-trifecta — open a 3-tab layout for a project in the current Herdr workspace.
#
#   tab 1 "AI" : the caller's tab, relabeled, with a `pi` coding agent started
#                in the caller's pane (pi launches after this script exits)
#   tab 2 "git": a plain shell for git work
#   tab 3 "CLI": two panes side-by-side (horizontal split), both empty shells
#
# The caller's tab becomes the AI tab; the git and CLI tabs are created without
# stealing focus, so the user lands on the AI tab. Run this from the pane you
# want pi to take over.
#
# Requires: HERDR_ENV=1, herdr in PATH, jq in PATH.

set -euo pipefail

die() { echo "herdr-trifecta: $*" >&2; exit 1; }

command -v herdr >/dev/null || die "herdr not found in PATH"
command -v jq    >/dev/null || die "jq not found in PATH"
[ "${HERDR_ENV:-}" = 1 ]    || die "not running inside Herdr (HERDR_ENV != 1). Run this from a Herdr-managed pane."

WORKSPACE="${HERDR_WORKSPACE_ID:?missing HERDR_WORKSPACE_ID}"
ORIG_TAB="${HERDR_TAB_ID:?missing HERDR_TAB_ID}"
ORIG_PANE="${HERDR_PANE_ID:?missing HERDR_PANE_ID}"
CWD="$PWD"

# Extract a field from the last herdr JSON response.
#   jget .result.tab.tab_id
jget() { jq -r "$1 // empty" <<<"$RESP"; }

echo "› workspace: $WORKSPACE   cwd: $CWD"

# --- tab 1: AI (relabel the caller's tab) -----------------------------------
# The caller's tab becomes the AI tab — relabel it instead of creating a new
# one, so the pane the user is already in becomes the agent pane.
herdr tab rename "$ORIG_TAB" "AI" >/dev/null \
  || die "failed to relabel AI tab ($ORIG_TAB)"
echo "› AI tab: $ORIG_TAB  pane: $ORIG_PANE"

# `agent start` requires the pane to already be at an interactive shell prompt,
# but this pane is busy running this very script, so it is NOT at a prompt yet.
# It only returns to its prompt after this script exits. We therefore detach a
# helper that polls `pane process-info` until the shell is back in the
# foreground (foreground pid == shell_pid), then starts pi. The helper is
# disowned so it survives this script's exit; `agent start` itself then waits
# for pi to be detected and ready for input. A poll timeout guards against
# spinning forever if the shell never returns.
( deadline=$(( $(date +%s) + 60 ))
  until [ "$(herdr pane process-info --pane "$ORIG_PANE" 2>/dev/null \
              | jq -r '.result.process_info
                       | ((.foreground_processes[0].pid // 0) == .shell_pid)')" = "true" ]; do
    [ "$(date +%s)" -ge "$deadline" ] && exit 1
    sleep 0.3
  done
  herdr agent start pi-agent --kind pi --pane "$ORIG_PANE" ) </dev/null >/dev/null 2>&1 &
disown 2>/dev/null || true
echo "› AI tab shell busy with this script — pi will start after exit"

# --- tab 2: git -------------------------------------------------------------
RESP=$(herdr tab create --workspace "$WORKSPACE" --cwd "$CWD" --label "git" --no-focus)
GIT_TAB=$(jget .result.tab.tab_id)
[ -n "$GIT_TAB" ] || die "failed to create git tab: $RESP"
echo "› git tab: $GIT_TAB  (empty shell at $CWD)"

# --- tab 3: CLI (two panes side-by-side) ------------------------------------
RESP=$(herdr tab create --workspace "$WORKSPACE" --cwd "$CWD" --label "CLI" --no-focus)
CLI_TAB=$(jget .result.tab.tab_id)
CLI_PANE=$(jget .result.root_pane.pane_id)
[ -n "$CLI_TAB" ] && [ -n "$CLI_PANE" ] || die "failed to create CLI tab: $RESP"

# Split to the right = panes arranged horizontally (left | right).
RESP=$(herdr pane split --pane "$CLI_PANE" --direction right --cwd "$CWD" --no-focus)
CLI_PANE2=$(jget .result.pane.pane_id)
[ -n "$CLI_PANE2" ] || die "failed to split pane in CLI tab: $RESP"
echo "› CLI tab: $CLI_TAB  panes: $CLI_PANE | $CLI_PANE2"

# Keep focus on the AI tab (the caller's tab) so the user lands on pi.
herdr tab focus "$ORIG_TAB" >/dev/null

echo "✓ trifecta ready — AI ($ORIG_TAB) · git ($GIT_TAB) · CLI ($CLI_TAB)"
echo "  pi is starting in this pane; it will appear momentarily."
