#!/bin/bash
#
# Interactively adopt config files into a stow-managed dotfiles repo.
# Select files to adopt — everything else is left untouched.

set -euo pipefail

R='\033[0;31m'
G='\033[0;32m'
Y='\033[1;33m'
C='\033[0;36m'
B='\033[1m'
NC='\033[0m'

usage() {
  echo -e "usage: ${B}stow-adopt${NC} <package> [source-dir]"
  echo "  package   name of the stow package (required)"
  echo "  source-dir  path to config files (default: ~/.config/<package>)"
  exit 1
}

[ $# -lt 1 ] && usage
PKG="$1"
SRC="${2:-$HOME/.config/$PKG}"
DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
STOW_DIR="$DOTFILES/$PKG"
TARGET="${STOW_TARGET:-$HOME}"

[[ "$SRC" == "$HOME"/* ]] || { echo -e "${R}error:${NC} source must be under \$HOME"; exit 1; }
[ -d "$SRC" ] || { echo -e "${R}error:${NC} source $SRC not found"; exit 1; }
[ -e "$STOW_DIR" ] && { echo -e "${R}error:${NC} $STOW_DIR already exists"; exit 1; }

rel_prefix="${SRC#$HOME/}"

items=()
while IFS= read -r -d '' f; do
  items+=("${f#$SRC/}")
done < <(find "$SRC" -mindepth 1 -maxdepth 1 -print0)

[ ${#items[@]} -eq 0 ] && echo -e "${Y}warning:${NC} no files in $SRC" && exit 0

unclassified=("${items[@]}")
adopted=()

echo -e "\n${C}📁 ${B}${SRC}${NC} → ${B}${STOW_DIR}${NC}\n"

classify_loop() {
  local output key item selected_items
  local -a display_items new_unclassified

  while [ ${#unclassified[@]} -gt 0 ]; do
    display_items=()
    for item in "${unclassified[@]}"; do
      if [ -d "$SRC/$item" ]; then
        display_items+=("$item/")
      else
        display_items+=("$item")
      fi
    done

    output=$(
      printf '%s\n' "${display_items[@]}" | fzf --multi \
        --prompt="(${#unclassified[@]} left) " \
        --header="[Tab] select | [Enter] adopt | [^D] dig dir | [^Q] done" \
        --preview="ls -lh \"$SRC\"/{} 2>&1" \
        --expect=ctrl-d,ctrl-q \
        --cycle 2>/dev/null || true
    )

    [ -z "$output" ] && echo -e "  ${Y}cancelled${NC}" && return 1

    key=$(printf '%s\n' "$output" | head -1)
    selected_items=()
    while IFS= read -r line; do
      [ -n "$line" ] && selected_items+=("${line%/}")
    done < <(printf '%s\n' "$output" | tail -n +2)

    case "$key" in
      ctrl-d)
        [ ${#selected_items[@]} -ne 1 ] && echo -e "  ${Y}select exactly one dir to dig${NC}" && continue
        item="${selected_items[0]}"
        [ ! -d "$SRC/$item" ] && echo -e "  ${Y}$item is not a directory${NC}" && continue
        new_unclassified=()
        for u in "${unclassified[@]}"; do
          [ "$u" != "$item" ] && new_unclassified+=("$u")
        done
        unclassified=("${new_unclassified[@]}")
        while IFS= read -r -d '' child; do
          unclassified+=("${child#$SRC/}")
        done < <(find "$SRC/$item" -mindepth 1 -maxdepth 1 -print0)
        echo -e "  ${C}expanded${NC} $item/"
        ;;
      ctrl-q)
        if [ ${#selected_items[@]} -gt 0 ]; then
          for item in "${selected_items[@]}"; do
            new_unclassified=()
            for u in "${unclassified[@]}"; do
              [ "$u" != "$item" ] && new_unclassified+=("$u")
            done
            unclassified=("${new_unclassified[@]}")
          done
        fi
        return 0
        ;;
      *)
        [ ${#selected_items[@]} -eq 0 ] && echo -e "  ${Y}no items selected${NC}" && continue
        for item in "${selected_items[@]}"; do
          adopted+=("$item")
          new_unclassified=()
          for u in "${unclassified[@]}"; do
            [ "$u" != "$item" ] && new_unclassified+=("$u")
          done
          unclassified=("${new_unclassified[@]}")
        done
        echo -e "  ${G}adopted${NC} ${#selected_items[@]} item(s)"
        ;;
    esac
  done
}

classify_loop || exit 1

[ ${#adopted[@]} -eq 0 ] && echo -e "  ${Y}nothing to adopt${NC}" && exit 0

echo ""
mkdir -p "$STOW_DIR"

for item in "${adopted[@]}"; do
  src_path="$SRC/$item"
  dest_path="$STOW_DIR/$rel_prefix/$item"
  mkdir -p "$(dirname "$dest_path")"
  if [ -d "$src_path" ]; then
    cp -r "$src_path" "$dest_path"
  else
    touch "$dest_path"
  fi
done

stow --adopt -t "$TARGET" -d "$DOTFILES" "$PKG"

echo ""
echo -e "${G}✅ done${NC}"
echo "  package: $STOW_DIR"
echo "  adopted: ${#adopted[@]} file(s)"
